<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Nature Explorer Page</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">


    <header class="bg-success text-white py-4 mb-4 text-center shadow-sm">
        <div class="container">
            <h1 class="fw-bold m-0">My Nature Explorer Page</h1>
        </div>
    </header>

    <main class="container">
        
        <!-- Assignment Info Section -->
        <div class="bg-white p-4 rounded-3 border shadow-sm mb-4">
            <h2 class="text-secondary fw-semibold mb-3">Containers in bootstrap</h2>
            <p class="fs-5 text-muted mb-0">
                In this assignment, you will build a nature-themed webpage using Bootstrap utility classes... 
                including a full-width header, a centered content area, multiple nature information cards, and a footer 
                with containers, colour classes, padding, and borders.
            </p>
        </div>

        <!-- Hobby Cards Section -->
        <div class="row g-3 mb-5">
            <div class="col-md-4">
                <div class="p-4 bg-danger-subtle text-danger-emphasis rounded-3 text-center border border-danger-subtle h-100">
                    <div class="fs-1 mb-2">🎨</div>
                    <h3 class="fw-bold fs-4">Art</h3>
                    <p class="mb-0">Drawing and painting nature scenes.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 bg-success-subtle text-success-emphasis rounded-3 text-center border border-success-subtle h-100">
                    <div class="fs-1 mb-2">📖</div>
                    <h3 class="fw-bold fs-4">Reading</h3>
                    <p class="mb-0">Exploring books about plants and animals.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 bg-warning-subtle text-warning-emphasis rounded-3 text-center border border-warning-subtle h-100">
                    <div class="fs-1 mb-2">🌱</div>
                    <h3 class="fw-bold fs-4">Gardening</h3>
                    <p class="mb-0">Growing flowers, herbs, and indoor plants.</p>
                </div>
            </div>
        </div>

    </main>

    <footer class="bg-dark text-white text-center py-3 mt-4">
        <p class="m-0">My Nature Explorer Page Bootstrap Container Assignment</p>
    </footer>
    
</body>
</html>
